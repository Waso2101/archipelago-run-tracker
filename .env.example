# Copy to .env and fill in.

# Name in the header, footer and page titles, and who runs the site (privacy page, footer).
SITE_NAME=Archipelago Run Tracker
SITE_OWNER=

# Admin login for /settings (add, edit, end and delete runs).
# Create the hash with:  node tools/make-password.mjs "your password"
ADMIN_PASSWORD_HASH=
# Random string that signs the login cookie, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Design for visitors who have not picked one (can also be changed in /settings):
# erdtree, liesofp, bg3, ds3, silksong, classic, archipelago, ozean, graphit, mono, hell
DEFAULT_DESIGN=archipelago

# Optional
# AP_DEFAULT_HOST=archipelago.gg
# MAX_ROOMS=30
